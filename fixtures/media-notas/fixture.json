      "codigo": "#include <stdio.h>\n\nint main(void) {\n    char linha[256];\n    double n1 = 0.0;\n    double n2 = 0.0;\n    double n3 = 0.0;\n    double n4 = 0.0;\n    double media = 0.0;\n\n    printf(\"Digite as 4 notas:\\n\");\n    if (fgets(linha, sizeof linha, stdin) != NULL) {\n        sscanf(linha, \"%lf\", &n1);\n    }\n    if (fgets(linha, sizeof linha, stdin) != NULL) {\n        sscanf(linha, \"%lf\", &n2);\n    }\n    if (fgets(linha, sizeof linha, stdin) != NULL) {\n        sscanf(linha, \"%lf\", &n3);\n    }\n    if (fgets(linha, sizeof linha, stdin) != NULL) {\n        sscanf(linha, \"%lf\", &n4);\n    }\n    media = (n1 + n2 + n3 + n4) / 4;\n    printf(\"Media: %.2f\\n\", media);\n    if (media >= 7) {\n        printf(\"Aprovado\\n\");\n    } else {\n        printf(\"Reprovado\\n\");\n    }\n    return 0;\n}\n",
